# ──────────────────────────────────────────────
# FinFlow AI — Root .gitignore
# ──────────────────────────────────────────────

# ── Environment Files ──────────────────────────
# Never commit .env files — they contain secrets
.env
.env.local
.env.development
.env.production
.env.test

# ── Dependencies ───────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build Output ───────────────────────────────
dist/
build/
.next/
out/

# ── Debug Logs ─────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── IDE & Editor ───────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS Files ───────────────────────────────────
.DS_Store
Thumbs.db
*.pem

# ── TypeScript ─────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Coverage ───────────────────────────────────
coverage/
.nyc_output/

# ── Uploads (local development) ────────────────
uploads/*
!uploads/.gitkeep

# ── Firebase ───────────────────────────────────
.firebase/
firebase-debug.log

# ── Docker ─────────────────────────────────────
docker-compose.override.yml
