# ──────────────────────────────────────────────
# FinFlow AI Enterprise — Environment Variables
# Root .env file (for reference only)
# ──────────────────────────────────────────────
# This file documents all environment variables used
# across the project. Actual values are in:
#   - server/.env    (server-side config)
#   - client/.env.local (client-side config)
# ──────────────────────────────────────────────

# ═══════════════════════════════════════════════
# SERVER CONFIGURATION
# ═══════════════════════════════════════════════

# --- Express Server ---
PORT=5000
NODE_ENV=development
LOG_LEVEL=dev

# --- CORS ---
CORS_ORIGIN=http://localhost:3000

# --- 🔒 Firebase Admin SDK ---
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com

# --- 🔒 OpenRouter AI ---
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here
OPENROUTER_MODEL=openai/gpt-3.5-turbo

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# --- File Upload ---
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# --- 🔒 Security ---
CSRF_SECRET=
ENCRYPTION_KEY=
SESSION_TIMEOUT_MS=86400000

# ═══════════════════════════════════════════════
# CLIENT CONFIGURATION (NEXT_PUBLIC_*)
# ═══════════════════════════════════════════════
# These are prefixed with NEXT_PUBLIC_ because
# Next.js exposes them to the browser.

# --- Firebase Client SDK ---
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123

# --- API URL ---
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# --- Feature Flags ---
NEXT_PUBLIC_ENABLE_AI_CHAT=true
NEXT_PUBLIC_ENABLE_OCR=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# ═══════════════════════════════════════════════
# 🔒 SECURITY NOTES
# ═══════════════════════════════════════════════
# 1. Never commit .env files to version control
# 2. Use different values per environment
# 3. Rotate API keys and secrets regularly
# 4. FIREBASE_PRIVATE_KEY is admin-level access
# 5. NEXT_PUBLIC_* vars are visible in the browser
# 6. Set CORS_ORIGIN to exact production URL
# ═══════════════════════════════════════════════
