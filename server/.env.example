# ──────────────────────────────────────────────
# FinFlow AI — Server Environment Variables
# Copy this file to .env and fill in your values
# 🔒 = Sensitive — never commit or share
# ──────────────────────────────────────────────

# ── Server ──────────────────────────────────────
# Port the API server listens on
PORT=5000

# Environment: development | production | test
NODE_ENV=development

# Logging format: dev | combined | common | short | tiny
LOG_LEVEL=dev

# ── CORS ────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# ── 🔒 Firebase Admin SDK ──────────────────────
# Get these from Firebase Console > Project Settings > Service Accounts
# These credentials have admin access to your Firebase project — keep them secret!
FIREBASE_PROJECT_ID=finflow-ai-a6289
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com

# ── 🔒 OpenRouter AI ────────────────────────────
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here
OPENROUTER_MODEL=openai/gpt-3.5-turbo

# ── Rate Limiting ───────────────────────────────
# Window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Max requests per window for general API
RATE_LIMIT_MAX=100

# Max requests per window for auth endpoints (stricter)
AUTH_RATE_LIMIT_MAX=20

# ── File Upload ─────────────────────────────────
# Maximum file size in bytes (default: 5 MB = 5242880)
MAX_FILE_SIZE=5242880

# Directory for uploaded files
UPLOAD_DIR=./uploads

# ── 🔒 CSRF Secret ──────────────────────────────
# Used to sign CSRF tokens (optional, auto-generated if empty)
CSRF_SECRET=

# ── 🔒 Encryption Key ───────────────────────────
# Used for encrypting sensitive data at rest
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Session Configuration ───────────────────────
# Session timeout in milliseconds (default: 24 hours = 86400000)
SESSION_TIMEOUT_MS=86400000

# ── Logging & Monitoring ────────────────────────
# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://xxx@sentry.io/xxx

# ── Feature Flags ───────────────────────────────
# Enable/disable features
ENABLE_AI_FEATURES=true
ENABLE_OCR_FEATURES=true
ENABLE_AUDIT_LOGGING=true

# ──────────────────────────────────────────────
# 🔒 CRITICAL SECURITY NOTES:
# 1. Never commit .env files to version control
# 2. Rotate credentials regularly
# 3. Use environment-specific secrets in production
# 4. Limit FIREBASE_PRIVATE_KEY access to admins only
# 5. Set strict CORS origins in production
# ──────────────────────────────────────────────
